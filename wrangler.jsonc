{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-saas2",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",

  "observability": {
    "enabled": true
  },

  "upload_source_maps": true,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudflare-saas-db",
      "database_id": "f3898b39-8829-4ba9-8e35-7152fce5fd5c"
    }
  ],

  "r2_buckets": [
    {
      "bucket_name": "cloudflare-saas-files",
      "binding": "cloudflare_saas_files",
      "remote": true
    }
  ],

  "vars": {
    "FRONTEND_ORIGIN": "http://localhost:5173"
  }
}
